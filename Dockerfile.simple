# Use a simpler approach - build locally first, then copy to Docker

# Base image
FROM node:20-alpine AS base

# Production image
FROM base AS runner
WORKDIR /app

ENV NODE_ENV=production

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

# Copy the built output from local .next directory
COPY --chown=nextjs:nodejs .next/standalone ./
COPY --chown=nextjs:nodejs .next/static ./.next/static

# Copy public from project root
COPY --chown=nextjs:nodejs public ./public

# Copy prisma files
COPY --chown=nextjs:nodejs prisma ./prisma
COPY --chown=nextjs:nodejs package.json ./package.json
COPY --chown=nextjs:nodejs prisma.config.ts ./

# Install only production prisma client dependencies
RUN apk add --no-cache openssl libc6-compat
RUN npm install @prisma/client @prisma/adapter-pg pg tsx dotenv typescript


# Set dummy DATABASE_URL for prisma generate (it only needs format validation)
ENV DATABASE_URL="postgresql://dummy:dummy@localhost:5432/dummy"
RUN npx prisma generate

RUN chown -R nextjs:nodejs /app

USER nextjs

EXPOSE 3000

ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

CMD ["node", "server.js"]
