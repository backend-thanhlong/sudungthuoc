# Copy this file to scripts/backup/backup.env and fill real values on the server.
# Do not commit scripts/backup/backup.env.

# Docker compose runtime
COMPOSE_ENV_FILE=.env.docker
COMPOSE_PROJECT_NAME=sudungthuoc
DB_SERVICE=db
APP_SERVICE=app

# Google Drive remote created by: rclone config
# Example remote path: gdrive:sudungthuoc-backups
BACKUP_GDRIVE_REMOTE=gdrive:sudungthuoc-backups

# Local staging directory on the server. Keep this outside the git repo when possible.
BACKUP_ROOT=/opt/sudungthuoc/backups

# Symmetric encryption passphrase used by gpg.
# Use a long random value and store it outside git.
BACKUP_ENCRYPTION_PASSPHRASE=replace-with-long-random-passphrase

# Retention
BACKUP_LOCAL_RETENTION_DAYS=7
BACKUP_REMOTE_RETENTION_DAYS=90

# Restore defaults
RESTORE_TARGET_DB=sudungthuoc_restore_check
RESTORE_STOP_APP=true
