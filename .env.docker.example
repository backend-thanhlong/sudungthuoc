# PostgreSQL
POSTGRES_DB=sudungthuoc_db
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-this-superuser-password

# Runtime DB account for the app
APP_DB_USER=sudungthuoc_app
APP_DB_PASSWORD=change-this-app-password
APP_DATABASE_URL="postgresql://sudungthuoc_app:change-this-app-password@db:5432/sudungthuoc_db?schema=public"

# Admin-only DB connection for Prisma maintenance
DATABASE_ADMIN_URL="postgresql://postgres:change-this-superuser-password@db:5432/sudungthuoc_db?schema=public"

# App secrets
AUTH_SECRET=replace-with-a-long-random-string
AUTH_URL=https://khoduoc.nvdcantho.com
REPORT_UPLOAD_SIGNING_SECRET=replace-with-another-long-random-string
DRUG_ORDER_QR_SIGNING_SECRET=replace-with-another-long-random-string
NODE_ENV=production

# AI Agent
AI_PRIMARY_PROVIDER=google
AI_PRIMARY_MODEL=gemini-2.5-flash-lite
GOOGLE_GENERATIVE_AI_API_KEY=
AI_ENABLE_FALLBACK=false
AI_FALLBACK_PROVIDER=openai
AI_FALLBACK_MODEL=gpt-5.4-mini
OPENAI_API_KEY=
AI_MAX_OUTPUT_TOKENS=1200
AI_PROVIDER_TIMEOUT_MS=30000
AI_ADMIN_CHAT_DAILY_LIMIT=80
AI_ADMIN_REVIEW_DAILY_LIMIT=40
AI_FACILITY_CHAT_DAILY_LIMIT=30
AI_FACILITY_REVIEW_DAILY_LIMIT=15

# Production seed is disabled by default
ALLOW_PRODUCTION_SEED=false
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=

# Cloudflare tunnel
TUNNEL_TOKEN=
